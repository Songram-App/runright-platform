FROM node:22-alpine AS webbuilder
WORKDIR /web
RUN corepack enable pnpm
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ .
RUN pnpm build

FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Embedded via //go:embed webdist in internal/server/static.go — overwrites
# the placeholder committed in the repo with the real built dashboard.
COPY --from=webbuilder /web/dist internal/server/webdist
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /runright-server ./cmd/server
# scratch has no filesystem beyond what's explicitly copied in; flyctl needs a
# real, writable $HOME (for its config/cache dir) when shelled out.
RUN mkdir -m 1777 /tmp-home

# flyctl is shelled out to by the cloud-provisioning feature (creating a
# dedicated Fly app + Postgres database per self-serve customer).
FROM flyio/flyctl:latest AS flyctl

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /tmp-home /tmp
COPY --from=builder /runright-server /runright-server
COPY --from=flyctl /flyctl /usr/local/bin/fly
EXPOSE 8080
ENTRYPOINT ["/runright-server"]
CMD ["serve"]
