FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /runright-server ./cmd/server

# flyctl is shelled out to by the cloud-provisioning feature (creating a
# dedicated Fly app + Postgres database per self-serve customer).
FROM flyio/flyctl:latest AS flyctl

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /runright-server /runright-server
COPY --from=flyctl /flyctl /usr/local/bin/fly
EXPOSE 8080
ENTRYPOINT ["/runright-server"]
CMD ["serve"]
